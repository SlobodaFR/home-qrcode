{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "@openfeature/ofrep-provider": "^0.2.5",
    "@openfeature/server-sdk": "^1.23.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "minio": "^8.0.7",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.74.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.1",
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
