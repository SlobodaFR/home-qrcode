# Auth (OAuth2 via auth.sloboda.fr)
AUTH_BASE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_WEBHOOK_SECRET=

# Feature flags home-features (OFREP) - optionnel. Absentes ou invalides : flags desactives, le defaut du code
# s'applique (le demarrage n'est jamais bloque). URL en https en production ; cle d'API serveur liee a
# l'app et a l'environnement (hf_ + 64 hex).
FEATURES_OFREP_URL=
FEATURES_API_KEY=
# Pin d'urgence d'un flag, prioritaire sur home-features : FEATURES_PIN_<CLE_EN_MAJ_SNAKE>=true|false
# ex. FEATURES_PIN_AUTH_VERIFY_TOKEN_CLAIMS=false

# App
FRONTEND_URL=https://qrcode.sloboda.fr
PORT=3000
# Reverse-proxy hops to trust for X-Forwarded-For (rate limit). 1 behind Caddy, unset locally.
TRUST_PROXY_HOPS=

# Database
DATABASE_PATH=/app/backend/data/qrcode.sqlite

# MinIO / Litestream
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REGION=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_REPLICA_PATH=
MINIO_ASSETS_PATH=

# Logs
# Random string of at least 32 bytes (openssl rand -base64 48); pseudonymizes user ids in logs. Required in production.
PSEUDONYM_SECRET=
